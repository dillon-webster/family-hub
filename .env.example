# Copy to .env and edit. Everything here has a working default except BIND_IP,
# which you almost certainly want to set.

# --- reachability -----------------------------------------------------------
# This machine's Tailscale address: `tailscale ip -4`. Binding to it means the
# hub is reachable from your devices on the tailnet and from nowhere else.
# Leave it unset and the hub only answers on the host itself.
BIND_IP=100.x.y.z
APP_PORT=3008

# --- who lives here ---------------------------------------------------------
# `Name:#hex` pairs. Read once, the first time the hub starts with an empty
# members table; after that, rename people through the API.
# The two colours are the design's own: terracotta and slate.
FAMILY_HUB_MEMBERS=Maya:#C8553D,Dan:#4F7CA0

# --- recipe scanning (optional) ---------------------------------------------
# Without a key, the link importer and manual entry still work; the scan route
# tells you it is switched off instead of failing at the camera.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- calendars --------------------------------------------------------------
# How often subscribed ICS feeds are re-fetched.
ICS_SYNC_INTERVAL_SECS=900

# --- housekeeping -----------------------------------------------------------
POSTGRES_PASSWORD=change-me
DB_PORT=5435
TZ=UTC
RUST_LOG=family_hub_server=info
